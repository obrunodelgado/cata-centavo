{
  "name": "cata-centavo-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the cata-centavo CLI, MCP server and web app",
  "license": "MIT",
  "author": "Marcus Xavier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcusXavierr/cata-centavo.git"
  },
  "homepage": "https://github.com/MarcusXavierr/cata-centavo#readme",
  "bugs": {
    "url": "https://github.com/MarcusXavierr/cata-centavo/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:cli": "node apps/cli/src/bin/cata-centavo.ts",
    "dev:web": "nx dev web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages/*/src apps/cli/src tests --format ./tools/eslint-formatter-agent.js",
    "lint:fix": "eslint packages/*/src apps/cli/src tests --fix --format ./tools/eslint-formatter-agent.js",
    "lint:sensor": "eslint packages/*/src apps/cli/src tests --format ./tools/eslint-formatter-sensor.js",
    "deps": "depcruise packages/*/src apps/cli/src tests --output-type plugin:$PWD/tools/depcruise-reporter-agent.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "precoverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"packages/*/src/**/*.ts\" --test-coverage-include=\"apps/cli/src/**/*.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "premutation": "node tools/stryker-preflight.js",
    "mutation": "stryker run && npm run mutation:report",
    "mutation:report": "node tools/stryker-report-agent.js",
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "npm run build -w cata-centavo",
    "build:web": "nx build web"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "next": "~16.1.6",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "pluggy-sdk": "^0.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nx/eslint": "23.1.2",
    "@nx/js": "23.1.2",
    "@nx/next": "^23.1.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/tap-runner": "^9.6.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "nx": "23.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
